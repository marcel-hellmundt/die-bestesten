# Options +FollowSymLinks
RewriteEngine On

# Waehrend eines Deploys liegt deploying.flag im Webroot (deploy-webapp.yml legt sie vor dem
# Upload an und loescht sie danach). So lange gibt es fuer jede Anfrage 503 mit der statischen
# Hinweis-Seite deploying.html statt eines halb hochgeladenen Standes.
ErrorDocument 503 /deploying.html

RewriteCond %{DOCUMENT_ROOT}/deploying.flag -f
RewriteCond %{REQUEST_URI} !^/deploying\.html$
RewriteRule ^ - [R=503,L]

RewriteCond %{SCRIPT_FILENAME} !-d
RewriteCond %{SCRIPT_FILENAME} !-f

RewriteRule ^.*$ ./index.html

<IfModule mod_headers.c>
  # index.html referenziert gehashte Bundle-Dateien -> darf nie stale gecacht werden,
  # sonst laedt ein Geraet nach einem Deploy Chunks, die auf dem Server geloescht wurden
  # (mirror --delete) und bekommt statt JS das SPA-Fallback-HTML zurueck.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "^deploying\.html$">
    Header always set Cache-Control "no-store"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
